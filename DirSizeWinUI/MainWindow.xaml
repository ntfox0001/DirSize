<Window
    x:Class="DirSize.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="14,10,14,6">
            <TextBlock Text="{Binding TextDisk}" VerticalAlignment="Center" FontSize="13"/>
            <ComboBox Width="230" VerticalAlignment="Center"
                      ItemsSource="{Binding Drives}"
                      SelectedItem="{Binding SelectedDrive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="Label"/>
            <Button Content="{Binding TextAskDoubao}" Click="Doubao_Click"/>
            <Button Content="{Binding TextOpenDir}" Command="{Binding OpenDirectoryCommand}"/>
            <Button Content="{Binding TextCancel}" Command="{Binding CancelCommand}"/>
            <Button Content="{Binding TextRefresh}" Command="{Binding RefreshCommand}" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- 中部 -->
        <Grid Grid.Row="1" Margin="14,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DDE1E6" BorderThickness="1" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding TextStructureHeader}" Margin="4,2,0,6" FontSize="12"/>
                    <TreeView Grid.Row="1" ItemsSource="{Binding Roots}" SelectionChanged="Tree_SelectionChanged">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding SizeText}" Foreground="#8E44AD"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#DDE1E6" BorderThickness="1" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding TextSubDirHeader}" Margin="4,2,0,6" FontSize="12"/>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding SelectedSummary}" TextWrapping="Wrap" Margin="2,0,2,6" FontSize="12"/>
                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding DirectoryList}"
                                  SelectedItem="{Binding ListSelection, Mode=TwoWay}"
                                  DoubleTapped="List_MouseDoubleClick">
                            <ListView.Header>
                                <Grid Padding="2,4,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TextColName}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TextColSize}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TextColSubfolders}" FontSize="12"/>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2,4,8,4" MinWidth="360">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#8E44AD" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SubfolderText}" Foreground="#8290A0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="14,0,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Height="5" IsIndeterminate="{Binding IsScanning, Mode=OneWay}"/>
            <TextBlock Grid.Row="1" Text="{Binding ProgressText, Mode=OneWay}" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="1" Text="{Binding StatusText, Mode=OneWay}" Margin="0,26,0,0"/>
        </Grid>
    </Grid>
</Window>