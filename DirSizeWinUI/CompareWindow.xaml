<Window
    x:Class="DirSize.CompareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：选择两份快照 -->
        <Grid Grid.Row="0" Margin="14,12,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TextSnapshotA}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                      ItemsSource="{Binding Snapshots}"
                      SelectedItem="{Binding SnapshotA, Mode=TwoWay}"
                      DisplayMemberPath="Display"/>
            <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" Margin="10,0" FontSize="14" Foreground="#8290A0"/>
            <TextBlock Grid.Column="3" Text="{Binding TextSnapshotB}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
            <ComboBox Grid.Column="4" VerticalAlignment="Center" MinWidth="230"
                      ItemsSource="{Binding Snapshots}"
                      SelectedItem="{Binding SnapshotB, Mode=TwoWay}"
                      DisplayMemberPath="Display"/>
        </Grid>

        <!-- 汇总行 + 过滤开关 -->
        <Grid Grid.Row="1" Margin="14,0,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Summary}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
            <CheckBox Grid.Column="1" Content="{Binding TextOnlyChanged}"
                      IsChecked="{Binding OnlyChanged, Mode=TwoWay}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 对比树 -->
        <Border Grid.Row="2" Margin="14,0" Background="#FFFFFF" BorderBrush="#DDE1E6" BorderThickness="1" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="30,6,10,6" Background="#F0F2F5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TextColPath}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding TextColA}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding TextColB}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{Binding TextColDiff}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
                <!-- TreeView 不直接放这里：WinUI3 TreeView 对 TreeViewItem 模板容器复用在重绑时会崩，
                     改为在代码隐藏里每次整体重建 TreeView（见 CompareWindow.xaml.cs）。 -->
                <ContentControl x:Name="TreeHost" Grid.Row="1"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.Resources>
                        <DataTemplate x:Key="DiffNodeTemplate">
                            <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <Grid MinWidth="560">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#55606B"/>
                                    <TextBlock Grid.Column="2" Text="{Binding BText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#55606B"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DiffText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Foreground="{Binding DiffBrush}" FontWeight="SemiBold"/>
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
        </Border>

        <!-- 底部状态 -->
        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="14,8,14,10" FontSize="12" Foreground="#8290A0"/>
    </Grid>
</Window>
