<Window x:Class="DirSize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DirSize.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="{Binding TextTitle}"
        Height="580" Width="920"
        WindowStartupLocation="CenterScreen"
        MinHeight="440" MinWidth="680"
        Loaded="Window_Loaded"
        Background="#F4F5F7">

    <Window.Resources>
        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：盘符选择 + 操作按钮 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="{Binding TextDisk}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
            <ComboBox DockPanel.Dock="Left" Width="200" VerticalAlignment="Center"
                      ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                      DisplayMemberPath="Label"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedDrive.Detail, FallbackValue=''}"
                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" Foreground="#7B8D93"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding TextOpenDir}" Command="{Binding OpenDirectoryCommand}" Style="{StaticResource TopButton}"
                        ToolTip="{Binding TextOpenDirTip}"/>
                <Button Content="{Binding TextCancel}" Command="{Binding CancelCommand}" Style="{StaticResource TopButton}"/>
                <Button Content="{Binding TextRefresh}" Command="{Binding RefreshCommand}"
                        Style="{StaticResource TopButton}" FontWeight="SemiBold"
                        ToolTip="{Binding TextRefreshTip}"/>
            </StackPanel>
        </DockPanel>

        <!-- 中部：左侧目录结构树 + 右侧子目录大小列表 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding TextStructureHeader}" Padding="4">
                <TreeView ItemsSource="{Binding Roots}"
                          ItemContainerStyle="{StaticResource TreeItemStyle}"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          BorderThickness="0" FontSize="13">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:DirectoryItemViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Margin="8,0,0,0"
                                           Foreground="#8E44AD" FontSize="11.5" ToolTip="{Binding DetailText}"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}"/>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </GroupBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#D5DBDB"/>

            <GroupBox Grid.Column="2" Header="{Binding TextSubDirHeader}" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedSummary}" TextWrapping="Wrap"
                               Margin="2,0,2,6" FontSize="12" Foreground="#5D6D7E"/>
                    <ListView ItemsSource="{Binding DirectoryList}"
                              SelectedItem="{Binding ListSelection, Mode=TwoWay}"
                              BorderThickness="0"
                              FontSize="12.5" MouseDoubleClick="List_MouseDoubleClick">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="{Binding TextColName}" Width="160" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="{Binding TextColSize}" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" Foreground="#8E44AD"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding TextColSubfolders}" Width="78" DisplayMemberBinding="{Binding SubfolderText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- 底部：进度与状态 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Height="6" Minimum="0" Maximum="1"
                         IsIndeterminate="{Binding IsScanning}"/>
            <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="12" Foreground="#5D6D7E"
                       TextWrapping="Wrap">
                <Run Text="{Binding ProgressText, Mode=OneWay}"/><LineBreak/>
                <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="#7B8D93"/>
            </TextBlock>
        </Grid>
    </Grid>
</Window>